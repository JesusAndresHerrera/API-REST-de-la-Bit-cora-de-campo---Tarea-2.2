        ],
        "url": "{{baseUrl}}/api/registros/{{registroIdActual}}",
        "description": "Comprueba que el PUT fue persistido, que se eliminó la foto y que la fecha original no cambió."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Solo usar el ID creado por el primer POST de esta ejecución.",
              "// El valor local inválido protege también a los clientes sin skipRequest().",
              "pm.variables.set(\"registroIdActual\", \"SIN_REGISTRO_PROPIO\");",
