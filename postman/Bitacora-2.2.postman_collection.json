{
  "info": {
    "_postman_id": "321f1497-a724-438f-997d-aa627b8d0616",
    "name": "Bitácora de campo - Tarea 2.2",
    "description": "16 solicitudes para ejecutar completas y en orden, una iteración. Cubre los cinco endpoints con éxito y fallo. El POST inicial crea un registro propio y guarda su ID; el DELETE lo elimina. No incluye un ID predeterminado ni borra registros ajenos. GET listado falla con Accept:application/xml (406). Para guardar evidencia, ejecutar en Postman y capturar respuestas y resultados reales. Los resultados de pruebas no vienen prellenados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5106",
      "type": "string"
    },
    {
      "key": "fotoPruebaBase64",
      "value": "iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAIAAAD91JpzAAAAEElEQVR4nGNQS5sJRAwQCgAeTgSVa+/JxgAAAABJRU5ErkJggg==",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 POST - Crear con fotografía (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/registros",
        "description": "Inicio obligatorio. Genera un token nuevo y elimina IDs anteriores. Guarda únicamente el ID devuelto por este POST, para que los siguientes pasos operen sobre su propio registro.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"{{_tituloPrueba}}\",\n  \"descripcion\": \"Observación de campo creada por la colección de Postman.\",\n  \"fotoBase64\": \"{{fotoPruebaBase64}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Una ejecución nueva nunca reutiliza el ID de una anterior.",
              "[\"_ownedId\", \"_ownerToken\", \"_fechaOriginal\"].forEach(function (key) {",
              "    pm.collectionVariables.unset(key);",
              "});",
              "const token = pm.variables.replaceIn(\"{{$guid}}\");",
              "pm.collectionVariables.set(\"_runToken\", token);",
              "pm.collectionVariables.set(\"_tituloPrueba\", \"Prueba Postman \" + token);",
              "pm.collectionVariables.set(\"_tituloEditado\", \"Editado Postman \" + token);",
              "pm.variables.set(\"registroIdActual\", \"SIN_REGISTRO_PROPIO\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "const expectedTitle = pm.collectionVariables.get(\"_tituloPrueba\");",
              "pm.test(\"El servidor asigna un ID válido\", function () {",
              "    pm.expect(body.id).to.be.a(\"number\").and.satisfy(Number.isInteger);",
              "    pm.expect(body.id).to.be.above(0);",
              "});",
              "pm.test(\"Título y foto recibidos\", function () {",
              "    pm.expect(body.titulo).to.eql(expectedTitle);",
              "    pm.expect(body.fotoBase64).to.eql(pm.collectionVariables.get(\"fotoPruebaBase64\"));",
              "});",
              "pm.test(\"Fecha UTC asignada por el servidor\", function () {",
              "    pm.expect(body.fechaCreacion).to.be.a(\"string\").and.match(/Z$/);",
              "    pm.expect(Number.isNaN(Date.parse(body.fechaCreacion))).to.eql(false);",
              "});",
              "pm.test(\"Location apunta al registro creado\", function () {",
              "    const location = pm.response.headers.get(\"Location\");",
              "    pm.expect(location).to.be.a(\"string\").and.include(\"/api/registros/\" + body.id);",
              "});",
              "if (pm.response.code === 201 && Number.isInteger(body.id) && body.id > 0 && body.titulo === expectedTitle) {",
              "    pm.collectionVariables.set(\"_ownedId\", String(body.id));",
              "    pm.collectionVariables.set(\"_ownerToken\", pm.collectionVariables.get(\"_runToken\"));",
              "    pm.collectionVariables.set(\"_fechaOriginal\", body.fechaCreacion);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 GET - Listar sin fotografías (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/registros",
        "description": "La lista puede contener otros registros. Verifica que el registro recién creado aparezca y que ninguno incluya el contenido de la fotografía."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Lista de registros sin FotoBase64\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an(\"array\");",
              "    body.forEach(function (registro) {",
              "        pm.expect(registro).to.have.property(\"id\");",
              "        pm.expect(registro).to.have.property(\"titulo\");",
              "        pm.expect(registro).not.to.have.property(\"fotoBase64\");",
              "        pm.expect(registro).not.to.have.property(\"fotografia\");",
              "    });",
              "});",
              "pm.test(\"El registro de esta ejecución está en la lista\", function () {",
              "    const id = Number(pm.collectionVariables.get(\"_ownedId\"));",
              "    pm.expect(id).to.be.above(0);",
              "    pm.expect(pm.response.json().some(function (r) { return r.id === id; })).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "03 GET - Formato XML no disponible (406)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/xml",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/registros",
        "description": "Caso fallido del listado: exige application/xml. La API ofrece JSON y tiene ReturnHttpNotAcceptable activado. Una lista vacía sería 200, no un error."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 406\", function () { pm.response.to.have.status(406); });",
              "pm.test(\"ProblemDetails comprensible\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql(406);",
              "    pm.expect(body.title).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "04 GET - Consultar detalle con fotografía (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/registros/{{registroIdActual}}",
        "description": "Consulta exclusivamente el ID devuelto por el POST inicial. El detalle incluye la foto completa."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Solo usar el ID creado por el primer POST de esta ejecución.",
              "// El valor local inválido protege también a los clientes sin skipRequest().",
              "pm.variables.set(\"registroIdActual\", \"SIN_REGISTRO_PROPIO\");",
              "const runToken = pm.collectionVariables.get(\"_runToken\");",
              "const ownerToken = pm.collectionVariables.get(\"_ownerToken\");",
              "const id = String(pm.collectionVariables.get(\"_ownedId\") || \"\");",
              "if (!runToken || ownerToken !== runToken || !/^[1-9][0-9]*$/.test(id)) {",
              "    if (pm.execution && typeof pm.execution.skipRequest === \"function\") {",
              "        pm.execution.skipRequest();",
              "    }",
              "    throw new Error(\"Ejecuta la colección completa desde 01 POST. No hay un ID propio válido para esta ejecución.\");",
              "}",
              "pm.variables.set(\"registroIdActual\", id);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Detalle e imagen coinciden con lo creado\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"_ownedId\")));",
              "    pm.expect(body.titulo).to.eql(pm.collectionVariables.get(\"_tituloPrueba\"));",
              "    pm.expect(body.fotoBase64).to.eql(pm.collectionVariables.get(\"fotoPruebaBase64\"));",
              "    pm.expect(body.fechaCreacion).to.eql(pm.collectionVariables.get(\"_fechaOriginal\"));",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
